# Estágio 1: Build de shared-core e admin-app
FROM node:20-alpine AS builder
WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci || npm install

COPY . .

# Compilar a biblioteca e o painel administrativo
RUN npm run build:core && npm run build:admin

# Estágio 2: Servidor Nginx Alpine
FROM nginx:1.25-alpine AS runner

COPY nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist/admin-app/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
